import {
  Plus,
  Trash2,
} from 'lucide-react'

import {
  Button,
} from '@/shared/ui/button'

import {
  Input,
} from '@/shared/ui/input'

import type {
  DynamicFieldOption,
} from '../types/category.types'

interface DynamicFieldOptionsEditorProps {
  value: DynamicFieldOption[]

  onChange: (
    value: DynamicFieldOption[],
  ) => void
}

export function DynamicFieldOptionsEditor({
  value,
  onChange,
}: DynamicFieldOptionsEditorProps) {
  function addOption() {
    onChange([
      ...value,
      {
        value: '',
        label: '',
      },
    ])
  }

  function updateOption(
    index: number,
    key: keyof DynamicFieldOption,
    newValue: string,
  ) {
    onChange(
      value.map(
        (option, optionIndex) =>
          optionIndex === index
            ? {
                ...option,
                [key]: newValue,
              }
            : option,
      ),
    )
  }

  function removeOption(
    index: number,
  ) {
    onChange(
      value.filter(
        (_, optionIndex) =>
          optionIndex !== index,
      ),
    )
  }

  return (
    <div className="rounded-xl border border-border bg-surface-muted/40 p-4">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h3 className="text-sm font-semibold text-foreground">
            گزینه‌های قابل انتخاب
          </h3>

          <p className="mt-1 text-xs text-muted-foreground">
            عنوانی که کاربر می‌بیند و مقدار داخلی هر گزینه را مشخص کنید.
          </p>
        </div>

        <Button
          type="button"
          variant="outline"
          size="sm"
          onClick={addOption}
        >
          <Plus size={16} />

          افزودن گزینه
        </Button>
      </div>

      {value.length === 0 ? (
        <div className="mt-4 rounded-xl border border-dashed border-border p-5 text-center">
          <p className="text-sm text-muted-foreground">
            هنوز گزینه‌ای تعریف نشده است.
          </p>
        </div>
      ) : (
        <div className="mt-4 space-y-3">
          {value.map(
            (option, index) => (
              <div
                key={index}
                className="grid gap-3 rounded-xl border border-border bg-surface p-3 md:grid-cols-[1fr_1fr_auto]"
              >
                <div>
                  <label className="mb-1.5 block text-xs font-medium text-muted-foreground">
                    عنوان نمایشی
                  </label>

                  <Input
                    value={
                      option.label
                    }
                    placeholder="مثلاً IP"
                    onChange={(
                      event,
                    ) =>
                      updateOption(
                        index,
                        'label',
                        event.target
                          .value,
                      )
                    }
                  />
                </div>

                <div>
                  <label className="mb-1.5 block text-xs font-medium text-muted-foreground">
                    مقدار سیستمی
                  </label>

                  <Input
                    dir="ltr"
                    value={
                      option.value
                    }
                    placeholder="ip"
                    onChange={(
                      event,
                    ) =>
                      updateOption(
                        index,
                        'value',
                        event.target
                          .value,
                      )
                    }
                  />
                </div>

                <div className="flex items-end">
                  <Button
                    type="button"
                    variant="ghost"
                    size="sm"
                    className="text-danger hover:bg-danger-soft hover:text-danger"
                    title="حذف گزینه"
                    onClick={() =>
                      removeOption(
                        index,
                      )
                    }
                  >
                    <Trash2
                      size={16}
                    />
                  </Button>
                </div>
              </div>
            ),
          )}
        </div>
      )}
    </div>
  )
}